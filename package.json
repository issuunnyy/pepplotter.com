{
  "name": "pepplotter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "backup": "bash scripts/backup.sh",
    "backup:quick": "bash scripts/backup.sh --quick",
    "backup:push": "bash scripts/backup.sh --push",
    "restore": "bash scripts/restore.sh",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy.ps1",
    "history": "git tag -l 'backup/*' --sort=-creatordate"
  },
  "dependencies": {
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
